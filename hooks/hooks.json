{
  "description": "Django Engineering Pack standalone guard: enforces hooks/security-policy.json on calls made by the pack's agents. Fails closed.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/django_pack_guard.py", "pre"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/django_pack_guard.py", "post"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
